namespace PrenaryDay27E

-- ★关口判定（零点自由度 ⟺ 常数性）：
--   存在统一平移 c 使所有残差同时归零  ⟺  残差本身在指标上取常值
theorem zero_point_free_iff {ι : Type*} (ε : ι → ℝ) :
    (∃ c : ℝ, ∀ i, ε i + c = 0) ↔ ∃ k : ℝ, ∀ i, ε i = k := by
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨-c, fun i => by have := hc i; linarith⟩
  · rintro ⟨k, hk⟩
    exact ⟨-k, fun i => by rw [hk i]; ring⟩

-- 左支具体化：常数残差可被一次平移整体归零（零点自由）
theorem const_shiftable (k : ℝ) : ∃ c : ℝ, k + c = 0 := ⟨-k, by ring⟩

-- 右支具体化：两个不同残差不能被同一次平移归零（零点被锚定）
theorem nonconst_not_shiftable (ε₁ ε₂ : ℝ) (h : ε₁ ≠ ε₂) :
    ¬ ∃ c : ℝ, ε₁ + c = 0 ∧ ε₂ + c = 0 := by
  rintro ⟨c, h1, h2⟩
  exact h (by linarith)

end PrenaryDay27E
