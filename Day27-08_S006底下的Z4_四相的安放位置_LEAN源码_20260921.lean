import Mathlib

/-! ================================================================
   偏元数学 · Day27-08 · S-006 底下的 ℤ/4：四相在数学侧的安放位置
   ------------------------------------------------------------------
   核心：S-006 §4.1 的覆叠阶梯就是「π₁(ℂ★) = ℤ 的商」——
         2ℤ ⟹ ℤ/2 ⟹ 覆叠 z ↦ z²（二重；S-006 已用，即"二态"）；
         4ℤ ⟹ ℤ/4 ⟹ 覆叠 z ↦ z⁴（四重）—— 此即"四相"在数学侧的位置。
         本件立 ℤ/4 的三条基性质，以及「相差 π 的那一对自成 ℤ/2」。
   本稿范围：① ℤ/4 非平凡；② 元素 2 是"二分之一圈"（2 + 2 = 0）；③ 2 ≠ 0；④ 四相互异。
   不做：不做覆叠映射 z ↦ z⁴ 的拓扑本身（承 Day26 路线，另件）。
   注：上承本日 Day27-01～07；与 NEW(S)-006 §4.1 的覆叠阶梯同构。
       同阶对照：Day26-01 的 `two_state_add_self : (1 : ZMod 2) + 1 = 0`（二态 = 阶 2）。
   日期：2026-09-21
   纪律：逐字提交 —— 抬头是提交原文的一部分，改动即改 SHA256。
   ================================================================ -/

namespace PrenaryDay27H

-- ① ℤ/4 非平凡：1 ≠ 0
theorem four_state_nontrivial : (1 : ZMod 4) ≠ 0 := by decide

-- ② 「二分之一圈」＝ 元素 2：2 + 2 = 0（相差 π 的那一对，自成 ℤ/2）
theorem half_turn_involution : (2 : ZMod 4) + 2 = 0 := by decide

-- ③ 它不是零：2 ≠ 0 —— 所以"半圈"非平凡
theorem half_turn_nontrivial : (2 : ZMod 4) ≠ 0 := by decide

-- ④ 四相各自可指认：0 ≠ 1 ∧ 1 ≠ 2 ∧ 2 ≠ 3
theorem four_states_distinct :
    (0 : ZMod 4) ≠ 1 ∧ (1 : ZMod 4) ≠ 2 ∧ (2 : ZMod 4) ≠ 3 := by decide

end PrenaryDay27H
